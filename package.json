{
  "name": "raffles",
  "version": "0.1.0",
  "private": true,
  "description": "Raffle management system for organizers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @raffles/api db:generate",
    "db:migrate": "pnpm --filter @raffles/api db:migrate",
    "db:studio": "pnpm --filter @raffles/api db:studio",
    "dev": "pnpm --filter @raffles/api dev",
    "dev:web": "pnpm --filter @raffles/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:int": "pnpm --filter @raffles/api test:int",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@11.10.0"
}
